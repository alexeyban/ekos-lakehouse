</fields><data><line><item>Ann</item><item>Lee</item><item>paid</item><item>3</item><item>120.5</item><item>2024-02-29</item></line></data></step><step><name>fullname</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var full = trim(first) + &#x27; &#x27; + trim(last);</jsScript_script></jsScript></jsScripts><fields><field><name>full</name><rename>full</rename><type>String</type><replace>N</replace></field></fields></step><step><name>tier</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var tier = &#x27;low&#x27;;
if (amount &gt; 1000) { tier = &#x27;high&#x27;; } else if (amount &gt; 100) { tier = &#x27;mid&#x27;; }</jsScript_script></jsScript></jsScripts><fields><field><name>tier</name><rename>tier</rename><type>String</type><replace>N</replace></field></fields></step><step><name>skip_void</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var keep = 1;
if (status == &#x27;void&#x27;) { trans_Status = SKIP_TRANSFORMATION; }</jsScript_script></jsScript></jsScripts><fields><field><name>keep</name><rename>keep</rename><type>Integer</type><replace>N</replace></field></fields></step><step><name>half</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var half = qty / 2;</jsScript_script></jsScript></jsScripts><fields><field><name>half</name><rename>half</rename><type>Number</type><replace>N</replace></field></fields></step><step><name>initials</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var ini = first.substring(0, 1).toUpperCase() + last.substring(0, 1).toUpperCase();</jsScript_script></jsScript></jsScripts><fields><field><name>ini</name><rename>ini</rename><type>String</type><replace>N</replace></field></fields></step><step><name>parse</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var code = parseInt(&#x27;42&#x27;) + qty;</jsScript_script></jsScript></jsScripts><fields><field><name>code</name><rename>code</rename><type>Integer</type><replace>N</replace></field></fields></step><step><name>nullsafe</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var who = isNull(last) ? &#x27;unknown&#x27; : lower(last);</jsScript_script></jsScript></jsScripts><fields><field><name>who</name><rename>who</rename><type>String</type><replace>N</replace></field></fields></step><step><name>datestr</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var day = date2str(created, &#x27;yyyy-MM-dd&#x27;);</jsScript_script></jsScript></jsScripts><fields><field><name>day</name><rename>day</rename><type>String</type><replace>N</replace></field></fields></step><step><name>replace_first</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var s = status.replace(&#x27;a&#x27;, &#x27;A&#x27;);</jsScript_script></jsScript></jsScripts><fields><field><name>s</name><rename>s</rename><type>String</type><replace>N</replace></field></fields></step><step><name>is_big</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var big = amount &gt; 100 &amp;&amp; status == &#x27;paid&#x27;;</jsScript_script></jsScript></jsScripts><fields><field><name>big</name><rename>big</rename><type>Boolean</type><replace>N</replace></field></fields></step><step><name>rounding</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var r = Math.round(amount);</jsScript_script></jsScript></jsScripts><fields><field><name>r</name><rename>r</rename><type>Integer</type><replace>N</replace></field></fields></step><step><name>concat_null</name><type>ScriptValueMod</type><compatible>N</compatible><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>m</jsScript_name><jsScript_script>var tag = &#x27;x-&#x27; + last;</jsScript_script></jsScript></jsScripts><fields><field><name>tag</name><rename>tag</rename><type>String</type><replace>N</replace></field></fields></step><step><name>udjc_label</name><type>UserDefinedJavaClass</type><definitions><definition><class_type>TRANSFORM_CLASS</class_type><class_name>P</class_name><class_source>public boolean processRow(StepMetaInterface smi, StepDataInterface sdi) throws KettleException {
  Object[] r = getRow();
  if (r == null) { setOutputDone(); return false; }
  r = createOutputRow(r, data.outputRowMeta.size());
  Long qty = get(Fields.In, &quot;qty&quot;).getInteger(r);
  String status = get(Fields.In, &quot;status&quot;).getString(r);
  if (qty == null) { return true; }
  get(Fields.Out, &quot;label&quot;).setValue(r, status.toUpperCase() + &quot;#&quot; + qty);
  putRow(data.outputRowMeta, r);
  return true;
}</class_source></definition></definitions><fields><field><field_name>label</field_name><field_type>String</field_type></field></fields></step><step><name>janino_flag</name><type>Janino</type><formula><field_name>flag</field_name><formula_string>(status == null) ? "none" : status.toUpperCase()</formula_string><value_type>String</value_type><value_length>-1</value_length><value_precision>-1</value_precision><replace_field/></formula></step></transformation>